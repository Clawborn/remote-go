<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <AssemblyName>RemoteGo</AssemblyName>
    <ApplicationIcon>RemoteGo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../Sources/Resources/chromecast-voice-remote.png" LogicalName="RemoteGo.Remote.png" />
    <EmbeddedResource Include="../../Sources/Resources/English.json" LogicalName="RemoteGo.English.json" />
    <Content Include="../../Sources/Resources/vRemoter-LICENSE.txt" Link="vRemoter-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../NAudio-LICENSE.txt" Link="NAudio-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
